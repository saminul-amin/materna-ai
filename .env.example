# Database (default: local SQLite file, zero infrastructure)
# For PostgreSQL/Supabase: change provider in prisma/schema.prisma to "postgresql" and use e.g.
# DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (use a long random string in production)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional: enables the LLM-backed assistant. If empty, a clearly-labelled rule-based prototype assistant is used.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Server-side directory for uploaded documents
UPLOAD_DIR="./uploads"
